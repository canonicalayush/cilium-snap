#!/bin/bash
# Runs on install and on every `snap set`.
#
# Renders snap configuration into $SNAP_DATA/config.env, which both wrappers
# source. This keeps the standalone flag set tunable without a rebuild --
# which matters, because that flag set is finicky (see the --ipam note in
# bin/cilium-agent-wrapper).
#
#   snap set cilium-snap debug=true ipam=delegated-plugin
set -eu

get() {
  local value
  value="$(snapctl get "$1" || true)"
  if [ -z "$value" ]; then
    # Fall back to the shipped default for this key.
    value="$(grep -E "^$2=" "$SNAP/etc/defaults.env" | cut -d= -f2-)"
  fi
  printf '%s' "$value"
}

# %q-escape: values are sourced by the wrappers, so an unescaped
# `extra-args='--foo --bar'` would run `--bar` as a command.
emit() {
  printf '%s=%q\n' "$1" "$2"
}

CONFIG="$SNAP_DATA/config.env"
RENDERED="$(mktemp "${SNAP_DATA}/.config.env.XXXXXX")"
trap 'rm -f "$RENDERED"' EXIT

{
  echo "# Generated by the configure hook. Edit via \`snap set\`, not by hand."
  emit ETCD_LISTEN_URL     "$(get etcd-listen-url ETCD_LISTEN_URL)"
  emit ETCD_WAIT_SECONDS   "$(get etcd-wait-seconds ETCD_WAIT_SECONDS)"
  emit IPAM                "$(get ipam IPAM)"
  emit LOCAL_ROUTER_IPV4   "$(get local-router-ipv4 LOCAL_ROUTER_IPV4)"
  emit ROUTING_MODE        "$(get routing-mode ROUTING_MODE)"
  emit NATIVE_ROUTING_CIDR "$(get native-routing-cidr NATIVE_ROUTING_CIDR)"
  emit ENABLE_IPV4         "$(get enable-ipv4 ENABLE_IPV4)"
  emit ENABLE_IPV6         "$(get enable-ipv6 ENABLE_IPV6)"
  emit EGRESS_INTERFACE    "$(get egress-interface EGRESS_INTERFACE)"
  emit IPV4_RANGE          "$(get ipv4-range IPV4_RANGE)"
  emit BPF_ROOT            "$(get bpf-root BPF_ROOT)"
  emit CGROUP_ROOT         "$(get cgroup-root CGROUP_ROOT)"
  emit DEBUG               "$(get debug DEBUG)"
  emit EXTRA_ARGS          "$(get extra-args EXTRA_ARGS)"
} > "$RENDERED"

# systemd rate-limits restarts (StartLimitBurst=5/10s, not exposed by snapd);
# only restart when the rendered config actually changed.
if [ -f "$CONFIG" ] && cmp -s "$RENDERED" "$CONFIG"; then
  exit 0
fi

mv "$RENDERED" "$CONFIG"

# Only restart if the services already exist; on first install the configure
# hook runs before they are started.
if snapctl services cilium-snap.cilium-agent >/dev/null 2>&1; then
  # Clears start-limit-hit before restarting; snapctl restart cannot recover
  # from it on its own.
  systemctl reset-failed snap.cilium-snap.cilium-agent.service >/dev/null 2>&1 || true
  snapctl restart cilium-snap.cilium-agent || true
fi

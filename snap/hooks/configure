#!/bin/bash
# Runs on install and on every `snap set`.
#
# Renders snap configuration into $SNAP_DATA/config.env, which both wrappers
# source. This keeps the standalone flag set tunable without a rebuild --
# which matters, because that flag set is finicky (see the --ipam note in
# bin/cilium-agent-wrapper).
#
#   snap set cilium-snap debug=true ipam=delegated-plugin
set -eu

get() {
  local value
  value="$(snapctl get "$1" || true)"
  if [ -z "$value" ]; then
    # Fall back to the shipped default for this key.
    value="$(grep -E "^$2=" "$SNAP/etc/defaults.env" | cut -d= -f2-)"
  fi
  printf '%s' "$value"
}

{
  echo "# Generated by the configure hook. Edit via \`snap set\`, not by hand."
  echo "ETCD_LISTEN_URL=$(get etcd-listen-url ETCD_LISTEN_URL)"
  echo "ETCD_WAIT_SECONDS=$(get etcd-wait-seconds ETCD_WAIT_SECONDS)"
  echo "IPAM=$(get ipam IPAM)"
  echo "LOCAL_ROUTER_IPV4=$(get local-router-ipv4 LOCAL_ROUTER_IPV4)"
  echo "ROUTING_MODE=$(get routing-mode ROUTING_MODE)"
  echo "NATIVE_ROUTING_CIDR=$(get native-routing-cidr NATIVE_ROUTING_CIDR)"
  echo "ENABLE_IPV4=$(get enable-ipv4 ENABLE_IPV4)"
  echo "ENABLE_IPV6=$(get enable-ipv6 ENABLE_IPV6)"
  echo "EGRESS_INTERFACE=$(get egress-interface EGRESS_INTERFACE)"
  echo "IPV4_RANGE=$(get ipv4-range IPV4_RANGE)"
  echo "BPF_ROOT=$(get bpf-root BPF_ROOT)"
  echo "CGROUP_ROOT=$(get cgroup-root CGROUP_ROOT)"
  echo "DEBUG=$(get debug DEBUG)"
  echo "EXTRA_ARGS=$(get extra-args EXTRA_ARGS)"
} > "$SNAP_DATA/config.env"

# Only restart if the services already exist; on first install the configure
# hook runs before they are started.
if snapctl services cilium-snap.cilium-agent >/dev/null 2>&1; then
  snapctl restart cilium-snap.cilium-agent || true
fi

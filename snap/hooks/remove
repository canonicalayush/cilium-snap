#!/bin/bash
# Runs once, on removal. Undoes install-cni's host-side writes: snapd has no
# notion that a one-shot app touched files outside $SNAP, so nothing else
# cleans these up.
set -eu

CNI_BIN_DIR="${CNI_BIN_DIR:-/opt/cni/bin}"

INSTALLED_BIN_MANIFEST="$SNAP_COMMON/installed-cni-bin"
INSTALLED_CONF_MANIFEST="$SNAP_COMMON/installed-cni-conf"

if [ -f "$INSTALLED_CONF_MANIFEST" ]; then
  rm -f "$(cat "$INSTALLED_CONF_MANIFEST")"
fi

if [ -f "$INSTALLED_BIN_MANIFEST" ]; then
  while IFS= read -r bin; do
    [ -n "$bin" ] || continue
    rm -f "$CNI_BIN_DIR/$bin"
  done < "$INSTALLED_BIN_MANIFEST"
fi

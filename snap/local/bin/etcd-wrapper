#!/bin/bash
# etcd, as Cilium's kvstore. See snap/snapcraft.yaml for why it is mandatory.
set -eu

# shellcheck disable=SC1091
. "$SNAP/etc/defaults.env"
[ -f "$SNAP_DATA/config.env" ] && . "$SNAP_DATA/config.env"

DATA_DIR="$SNAP_COMMON/etcd/data"
mkdir -p "$DATA_DIR"

# Single-node, loopback-only: this kvstore serves exactly one cilium-agent on
# this host. No peer traffic leaves the box.
exec "$SNAP/usr/bin/etcd" \
  --name cilium-snap \
  --data-dir "$DATA_DIR" \
  --listen-client-urls "$ETCD_LISTEN_URL" \
  --advertise-client-urls "$ETCD_LISTEN_URL" \
  --listen-peer-urls http://127.0.0.1:2380 \
  --initial-advertise-peer-urls http://127.0.0.1:2380 \
  --initial-cluster cilium-snap=http://127.0.0.1:2380

# Defaults for cilium-snap. Overridden by `snap set`; the configure
# hook renders the effective values into $SNAP_DATA/config.env.
ETCD_LISTEN_URL=http://127.0.0.1:2379
ETCD_WAIT_SECONDS=60
# etcd snap's client-URL bind address, rendered by setup-etcd. 127.0.0.1
# serves this host only; widen for other agent hosts (see README).
ETCD_BIND_ADDRESS=127.0.0.1:2379
# cluster-pool allocates from IPV4_RANGE directly; delegated-plugin also
# works but needs an external CNI IPAM plugin.
IPAM=cluster-pool
# Required by --ipam=delegated-plugin; harmless under cluster-pool.
LOCAL_ROUTER_IPV4=169.254.1.1
# Forced to native: --local-router-ipv4 requires native/hybrid routing.
ROUTING_MODE=native
# Required by native routing + masquerade. Must cover the pod range below.
NATIVE_ROUTING_CIDR=10.20.0.0/16
# Single-stack default; IPv6 also needs --ipv6-native-routing-cidr and
# --local-router-ipv6.
ENABLE_IPV4=true
ENABLE_IPV6=false
# Required when masquerading with a non-cluster-pool/kubernetes IPAM mode.
# Empty means: auto-detect the default-route interface at start.
EGRESS_INTERFACE=
# Pod CIDR this node allocates from under cluster-pool.
IPV4_RANGE=10.20.0.0/16
# Namespaces this agent's kvstore keys when multiple agent groups share
# one etcd. cluster-name must differ from "default" if cluster-id != 0.
CLUSTER_NAME=default
CLUSTER_ID=0
# kvstore node-name override (cilium/state/nodes/v1/<cluster-name>/<node-name>);
# empty falls back to hostname. Must be distinct per node sharing one etcd.
NODE_NAME=
# L2 routes between node PodCIDRs, no overlay. Only works when the agent
# hosts share one L2 segment; across an L3/routed boundary distribute pod
# CIDRs with static routes or BGP instead (see README).
ENABLE_AUTO_DIRECT_NODE_ROUTES=false
BPF_ROOT=/sys/fs/bpf
CGROUP_ROOT=/run/cilium/cgroupv2
DEBUG=false
EXTRA_ARGS=

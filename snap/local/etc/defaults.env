# Defaults for cilium-snap. Overridden by `snap set`; the configure
# hook renders the effective values into $SNAP_DATA/config.env.
ETCD_LISTEN_URL=http://127.0.0.1:2379
ETCD_WAIT_SECONDS=60
# Address the external `etcd` snap's client URL binds to, rendered by
# `cilium-snap.setup-etcd` into its etcd.conf.yml. 127.0.0.1 only serves
# agents on this host; set to 0.0.0.0:2379 or a routable host:port to serve
# agents on other hosts too.
ETCD_BIND_ADDRESS=127.0.0.1:2379
# cluster-pool: the agent allocates from IPV4_RANGE itself. Verified working
# standalone. delegated-plugin also works but needs an external CNI IPAM
# plugin to do allocation.
IPAM=cluster-pool
# Required by --ipam=delegated-plugin; harmless under cluster-pool.
LOCAL_ROUTER_IPV4=169.254.1.1
# Forced to native: --local-router-ipv4 requires native/hybrid routing.
ROUTING_MODE=native
# Required by native routing + masquerade. Must cover the pod range below.
NATIVE_ROUTING_CIDR=10.20.0.0/16
# Single-stack PoC. Enabling IPv6 additionally requires
# --ipv6-native-routing-cidr and --local-router-ipv6.
ENABLE_IPV4=true
ENABLE_IPV6=false
# Required when masquerading with a non-cluster-pool/kubernetes IPAM mode.
# Empty means: auto-detect the default-route interface at start.
EGRESS_INTERFACE=
# Pod CIDR this node allocates from under cluster-pool.
IPV4_RANGE=10.20.0.0/16
# Identifies this agent's kvstore namespace when multiple independent agent
# groups share one etcd instance. cilium-agent requires cluster-name != the
# literal string "default" whenever cluster-id is non-zero.
CLUSTER_NAME=default
CLUSTER_ID=0
# Overrides the kvstore node-name cilium-agent registers under
# (cilium/state/nodes/v1/<cluster-name>/<node-name>); empty falls back to
# the host's hostname. Every node sharing one etcd instance under the same
# cluster-name MUST have a distinct node name, or agents will repeatedly
# overwrite each other's node registration.
NODE_NAME=
# L2 routes between node PodCIDRs without an overlay. Required for
# pod-to-pod connectivity across hosts when multiple agents share one etcd
# and routing-mode is native (the default here); leave false for a single
# standalone node.
ENABLE_AUTO_DIRECT_NODE_ROUTES=false
BPF_ROOT=/sys/fs/bpf
CGROUP_ROOT=/run/cilium/cgroupv2
DEBUG=false
EXTRA_ARGS=
